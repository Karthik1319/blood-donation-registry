# Copy to .env (never commit .env). Used by both docker compose and Spring Boot.
DB_URL=jdbc:postgresql://localhost:5432/blood_donation
DB_USERNAME=bdr_app
DB_PASSWORD=change-me-local-only

# Signs the access tokens. At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Creates demo users, donors and donations when the database is empty (local development only).
DEMO_DATA=true
