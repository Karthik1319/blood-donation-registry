# Loaded automatically by "npm run dev". VITE_ variables are PUBLIC (bundled into the browser):
# never put secrets here.

# Relative path: the Vite dev server proxies /api to the Spring Boot server (see vite.config.js).
VITE_API_BASE_URL=/api

# true  = in-memory mock API, no backend needed.
# false = real Spring Boot API (start the backend on port 8080 first).
VITE_USE_MOCK_API=true
