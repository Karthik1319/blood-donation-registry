# Copy this file to ".env" and adjust if needed.
# VITE_ variables are bundled into the browser code, so they are PUBLIC. Never put secrets here.
VITE_API_BASE_URL=/api
VITE_APP_NAME=Blood Donation Registry

# Used only by the Vite dev server (not exposed to the browser): where the Spring Boot API runs.
API_PROXY_TARGET=http://localhost:8080
